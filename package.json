{
  "name": "paper2experiment",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop research harness",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
