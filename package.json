{
  "name": "methodiy-ai",
  "version": "0.1.0",
  "productName": "Methodiy AI",
  "private": true,
  "description": "Methodiy AI — paper-grounded scientific research workspace",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@napi-rs/canvas": "0.1.100",
    "@typesafe-ai/sdk": "0.7.0",
    "cheerio": "1.1.2",
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "smartcompact": "0.1.8",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.0.0",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "overrides": {
    "undici": "8.12.3",
    "katex": "0.19.1"
  }
}
